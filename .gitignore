# Secrets and environment
.env
google-credentials*.json
credentials/*.json

# IID-AUTH-BASIC: runtime user registry (emails + bcrypt hashes, created on first registration)
users.yaml

# Runtime data
logs/
# IID-SHEETS-LOG: weekly CSV backups of Google Sheet (student data)
exports/
# IID-LEARN-GOALS: local-JSON fallback for per-student goal progress
progress/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Chainlit (track config.toml, ignore generated translations)
.chainlit/translations/
# IID-EDUCATOR-CONFIG, IID-MULTI-DEPLOY: sidebar panel generated at startup from <content_dir>/_readme.md
chainlit.md

# Virtual environment
.venv/

# OS
.DS_Store
Thumbs.db

# Lecture content is tracked in git (required for Railway deploy)

# Agent done plans (not tracked)
agent/done/

# Test reports (generated locally by tests/compare.py — IID-TEST-MODEL-COMPARE)
reports/

# IID-ASSIGNMENT-HELP: assignment solutions must not be published (the GitHub repo is public).
# Deployed to Railway via .railwayignore + `railway up --no-gitignore` (see CLAUDE.md).
content_timeseries/**/*_solution.qmd
# Local junctions to lecture folders outside the repo (source of the copied content files)
junctions/
